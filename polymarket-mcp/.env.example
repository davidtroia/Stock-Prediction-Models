# ============================================================
# Polymarket US API credentials
# Create a key at https://polymarket.us/developer (sign in with the same
# method you used in the app). The secret is shown ONLY ONCE at creation.
# ============================================================
POLYMARKET_KEY_ID=your_key_id_uuid
POLYMARKET_SECRET_KEY=your_base64_ed25519_secret

# Market-data tools work without these. Account and trading tools require them.

# ============================================================
# Guardrails — trading safety limits
# All limits are enforced automatically before every order.
# Change these values and restart the server to update them.
#
# Note: prediction-market limits are denominated in DOLLARS of notional,
# not percentages, because max loss on a long is exactly what you paid.
# ============================================================

# Maximum notional (price x quantity) of any single order (default: $50)
MAX_SINGLE_ORDER_USD=50

# Maximum total dollars at risk in any one market (default: $100)
MAX_MARKET_EXPOSURE_USD=100

# Maximum total dollars at risk across all markets combined (default: $500)
MAX_TOTAL_EXPOSURE_USD=500

# Always keep at least this much cash uncommitted (default: $25)
MIN_CASH_RESERVE_USD=25

# Halt new buys after losing this much in a day (default: $50)
DAILY_LOSS_LIMIT_USD=50

# Maximum number of distinct markets held at once (default: 10)
MAX_OPEN_POSITIONS=10

# Refuse to BUY below this implied probability — blocks longshot lottery tickets
# (default: 0.05, i.e. 5 cents)
MIN_PRICE=0.05

# Refuse to BUY above this implied probability — blocks paying 97c to make 3c
# (default: 0.95)
MAX_PRICE=0.95

# Maximum slippage tolerance accepted on market orders, in basis points
# (default: 200 = 2%). Requests above this are capped down, not rejected.
MAX_SLIPPAGE_BIPS=200

# Whitelist: comma-separated categories that are the ONLY ones tradeable.
# Leave empty to allow all. Example: ALLOWED_CATEGORIES=sports,economics
ALLOWED_CATEGORIES=

# Blacklist: comma-separated categories to NEVER trade.
# Example: BLOCKED_CATEGORIES=politics
BLOCKED_CATEGORIES=

# Comma-separated market slugs to never trade, regardless of anything else.
BLOCKED_MARKET_SLUGS=

# ============================================================
# Order tagging
# ============================================================
# Orders from this server are algorithmic and are flagged AUTOMATIC by default
# (FIX tag 1028 semantics). Only set this if you have a specific reason to
# report orders as manually entered.
POLYMARKET_MARK_ORDERS_MANUAL=false
